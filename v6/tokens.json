{
  "$description": "AI Orbit Version 6 \"Spatial\" design tokens (W3C Design Tokens format; importable with Tokens Studio for Figma). Mirrors :root in v6/assets/css/v6.css.",
  "color": {
    "void": {
      "100": { "$type": "color", "$value": "#1E104E", "$description": "Base background (--void)" },
      "200": { "$type": "color", "$value": "#180C42", "$description": "--void-2" },
      "300": { "$type": "color", "$value": "#110835", "$description": "--void-3" },
      "400": { "$type": "color", "$value": "#0B0526", "$description": "--void-4 (deepest)" }
    },
    "energy": {
      "coral": { "$type": "color", "$value": "#FF653F", "$description": "Primary energy (--coral)" },
      "cobalt": { "$type": "color", "$value": "#2F2FE4", "$description": "Primary energy (--cobalt)" },
      "coral-text": { "$type": "color", "$value": "#FF8A6B", "$description": "Coral for text on void, ≥ 4.5:1 (--coral-text)" },
      "cobalt-text": { "$type": "color", "$value": "#A3A3FF", "$description": "Cobalt for text/lines on void (--cobalt-text)" },
      "signal": { "$type": "color", "$value": "#5BF0B5", "$description": "Live / success ping (--signal)" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#F7F4FF", "$description": "--fg" },
      "muted": { "$type": "color", "$value": "#D2CBEC", "$description": "--fg-muted" },
      "subtle": { "$type": "color", "$value": "#ABA1D3", "$description": "--fg-subtle (≥ 4.5:1 on void)" }
    },
    "glass": {
      "base": { "$type": "color", "$value": "rgba(30, 16, 78, 0.45)", "$description": "--glass; pair with background blur 24px" },
      "high": { "$type": "color", "$value": "rgba(46, 28, 112, 0.55)", "$description": "--glass-hi" }
    },
    "line": {
      "hair": { "$type": "color", "$value": "rgba(255, 255, 255, 0.10)", "$description": "--hair" },
      "hair-2": { "$type": "color", "$value": "rgba(255, 255, 255, 0.18)", "$description": "--hair-2" },
      "hair-3": { "$type": "color", "$value": "rgba(255, 255, 255, 0.28)", "$description": "--hair-3" }
    }
  },
  "gradient": {
    "energy": { "$type": "gradient", "$value": [{ "color": "#FF653F", "position": 0 }, { "color": "#B44BC0", "position": 0.48 }, { "color": "#2F2FE4", "position": 1 }], "$description": "Borders, fills, indicators (120deg)" },
    "energy-text": { "$type": "gradient", "$value": [{ "color": "#FF8862", "position": 0 }, { "color": "#F070C4", "position": 0.5 }, { "color": "#A6A6FF", "position": 1 }], "$description": "Gradient headline words; every stop ≥ 5.3:1 against the live hero field" }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "Space Grotesk" },
    "body": { "$type": "fontFamily", "$value": "Plus Jakarta Sans" }
  },
  "typography": {
    "mega": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "92px", "lineHeight": 1.04, "letterSpacing": "-0.035em" }, "$description": "clamp(2.75rem, 1.1rem + 5.2vw, 5.75rem)" },
    "h1": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "60px", "lineHeight": 1.08, "letterSpacing": "-0.03em" } },
    "h2": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "48px", "lineHeight": 1.12, "letterSpacing": "-0.025em" } },
    "h3": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "22px", "lineHeight": 1.32, "letterSpacing": "-0.012em" } },
    "lead": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "21px", "lineHeight": 1.62 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.68 } },
    "small": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.62 } },
    "kicker": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 600, "fontSize": "12.5px", "lineHeight": 1.3, "letterSpacing": "0.16em", "textCase": "uppercase" } },
    "button": { "$type": "typography", "$value": { "fontFamily": "{font.body}", "fontWeight": 600, "fontSize": "15.7px", "lineHeight": 1.2 } }
  },
  "radius": {
    "s": { "$type": "dimension", "$value": "10px" },
    "m": { "$type": "dimension", "$value": "18px" },
    "l": { "$type": "dimension", "$value": "28px" },
    "portal": { "$type": "dimension", "$value": "32px" }
  },
  "effect": {
    "glass-blur": { "$type": "dimension", "$value": "24px", "$description": "backdrop-filter: blur(24px) saturate(140%)" },
    "button-inner-glow": { "$type": "shadow", "$value": [{ "inset": true, "color": "rgba(255,255,255,0.14)", "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px" }, { "inset": true, "color": "rgba(255,101,63,0.10)", "offsetX": "0px", "offsetY": "0px", "blur": "22px", "spread": "0px" }] }
  },
  "motion": {
    "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$description": "Overshoot spring for knobs, icons, panels" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
    "tab-indicator": { "$type": "string", "$value": "spring stiffness 260, damping 26 (JS)" }
  },
  "layout": {
    "max-width": { "$type": "dimension", "$value": "1320px" },
    "gutter": { "$type": "dimension", "$value": "clamp(20px, 5vw, 72px)" }
  }
}
