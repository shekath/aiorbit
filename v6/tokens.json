{
  "$description": "AI Orbit Version 6 \"Signal\" design tokens (W3C Design Tokens format; importable with Tokens Studio for Figma). Mirrors :root in v6/assets/css/v6.css. Two themes: dark and light.",
  "color": {
    "dark": {
      "bg": { "$type": "color", "$value": "#0A0A0A" },
      "bg-2": { "$type": "color", "$value": "#111111" },
      "bg-3": { "$type": "color", "$value": "#161616" },
      "fg": { "$type": "color", "$value": "#F4F4F1" },
      "fg-2": { "$type": "color", "$value": "#B9B9B3" },
      "fg-3": { "$type": "color", "$value": "#8F8F8A" },
      "line": { "$type": "color", "$value": "rgba(255, 255, 255, 0.12)" },
      "line-2": { "$type": "color", "$value": "rgba(255, 255, 255, 0.22)" },
      "mint": { "$type": "color", "$value": "#73FFB9", "$description": "Signal accent (fills, pulses, emphasis text)" },
      "ember": { "$type": "color", "$value": "#FF6338", "$description": "Secondary signal (backward pulses, required marks)" },
      "glass": { "$type": "color", "$value": "rgba(20, 20, 20, 0.55)", "$description": "Translucent CTA / sheet surface, blur 16px" }
    },
    "light": {
      "bg": { "$type": "color", "$value": "#F2F2EE" },
      "bg-2": { "$type": "color", "$value": "#E9E9E4" },
      "bg-3": { "$type": "color", "$value": "#E1E1DB" },
      "fg": { "$type": "color", "$value": "#0A0A0A" },
      "fg-2": { "$type": "color", "$value": "#3D3D3A" },
      "fg-3": { "$type": "color", "$value": "#5E5E59" },
      "line": { "$type": "color", "$value": "rgba(10, 10, 10, 0.12)" },
      "line-2": { "$type": "color", "$value": "rgba(10, 10, 10, 0.22)" },
      "mint": { "$type": "color", "$value": "#19C27A", "$description": "Fills and pulses" },
      "mint-text": { "$type": "color", "$value": "#086A40", "$description": "Emphasis text, ≥ 4.5:1 on bg and bg-2" },
      "ember": { "$type": "color", "$value": "#E5531F" },
      "ember-text": { "$type": "color", "$value": "#B93A12" },
      "glass": { "$type": "color", "$value": "rgba(255, 255, 255, 0.55)" }
    },
    "cta": {
      "black-bg": { "$type": "color", "$value": "#000000", "$description": "Black CTA in both themes" },
      "black-fg": { "$type": "color", "$value": "#FFFFFF" },
      "outline-run-dark": { "$type": "color", "$value": "#73FFB9", "$description": "Animated outline segment (solid, no gradient)" },
      "outline-run-light": { "$type": "color", "$value": "#19C27A" }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": "PP Neue Montreal", "$description": "Commercial (Pangram Pangram) — license + self-host for production. Fallback: Helvetica Neue, Arial." },
    "tech": { "$type": "fontFamily", "$value": "Jura", "$description": "Google Fonts — indices, labels, data, numbers" }
  },
  "typography": {
    "giant": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 500, "fontSize": "144px", "lineHeight": 0.96, "letterSpacing": "-0.045em" }, "$description": "clamp(3rem, 1rem + 7.2vw, 9rem)" },
    "h1": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 500, "fontSize": "88px", "lineHeight": 1, "letterSpacing": "-0.04em" } },
    "h2": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 500, "fontSize": "68px", "lineHeight": 1.02, "letterSpacing": "-0.035em" } },
    "h3": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 500, "fontSize": "28px", "lineHeight": 1.2, "letterSpacing": "-0.02em" } },
    "lead": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 400, "fontSize": "22px", "lineHeight": 1.5 } },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.6 } },
    "label": { "$type": "typography", "$value": { "fontFamily": "{font.tech}", "fontWeight": 600, "fontSize": "12.5px", "lineHeight": 1.35, "letterSpacing": "0.14em", "textCase": "uppercase" } },
    "data-xl": { "$type": "typography", "$value": { "fontFamily": "{font.tech}", "fontWeight": 600, "fontSize": "128px", "lineHeight": 0.9, "letterSpacing": "-0.04em" } },
    "button": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontWeight": 500, "fontSize": "16px", "lineHeight": 1.2 } }
  },
  "radius": { "none": { "$type": "dimension", "$value": "0px", "$description": "Signal uses square corners throughout" } },
  "motion": {
    "in-out": { "$type": "cubicBezier", "$value": [0.76, 0, 0.24, 1], "$description": "Line fills, drawer, header, wipes" },
    "spring": { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$description": "Icons, switch knob, magnetic return" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
    "outline-run": { "$type": "duration", "$value": "3.2s", "$description": "Black CTA outline loop; hover draws the full outline" },
    "ticker": { "$type": "duration", "$value": "50s" }
  },
  "layout": {
    "columns": { "$type": "number", "$value": 12 },
    "max-width": { "$type": "dimension", "$value": "1440px" },
    "gutter": { "$type": "dimension", "$value": "clamp(20px, 4.4vw, 64px)" },
    "header-height": { "$type": "dimension", "$value": "72px" }
  }
}
